{
  "manifest_version": 3,
  "name": "술술 읽기",
  "short_name": "술술 읽기",
  "version": "1.0.0",
  "description": "어떤 웹페이지든 글자 크기·줄 간격·배경색을 바꾸고, 줄 가리개와 소리 내어 읽기(단어 따라가기)로 읽기를 돕는 학생용 도우미",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "술술 읽기 (Alt+Shift+R)",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "commands": {
    "toggle-reader": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "읽기 도우미 켜기/끄기"
    }
  }
}
